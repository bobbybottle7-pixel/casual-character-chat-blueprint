# Cam Claude runs on your Claude Code login by default - no key needed here.
# Run `claude login` once on this machine and leave this file alone.

# Optional: force API-key auth instead (metered, billed per token).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# PORT=8787
# CAM_CLAUDE_DB=./data/cam-claude.db
# CAM_CLAUDE_MODEL=opus
